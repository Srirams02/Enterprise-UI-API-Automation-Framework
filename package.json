{
  "name": "enterprise-ui-api-automation-framework",
  "version": "1.0.0",
  "description": "Enterprise Playwright Framework",
  "scripts": {
    "test": "npx playwright test",
    "ui": "npx playwright test tests/ui",
    "api": "npx playwright test tests/api",
    "e2e": "npx playwright test tests/e2e",
    "headed": "npx playwright test --headed",
