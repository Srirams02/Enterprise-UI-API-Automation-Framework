    "allure": "allure generate ./allure-results --clean && allure open"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "allure-playwright": "latest",
    "cross-env": "latest",
    "dotenv": "^17.4.2",
    "faker": "latest",
    "nodemailer": "^8.0.7"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0"
  }
}
